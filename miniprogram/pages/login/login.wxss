.container {
  width: 100vw;
  height: 100vh;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
}

.login-content {
  width: 100%;
  padding: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 100rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.2);
  margin-bottom: 32rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
}

.app-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 已登录状态 */
.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-bottom: 24rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.login-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 登录按钮区域 */
.login-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  background: white;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  border: none;
  margin-bottom: 24rpx;
}

.login-btn::after {
  border: none;
}

.unauthorized-card {
  width: 100%;
  background: white;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
}

.unauthorized-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 18rpx;
  text-align: center;
}

.unauthorized-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #666;
  text-align: center;
  margin-bottom: 32rpx;
}

.openid-box {
  background: #f6f7fb;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.openid-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.openid-value {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: #333;
  word-break: break-all;
}

.copy-btn,
.retry-btn {
  width: 100%;
  height: 84rpx;
  border-radius: 42rpx;
  font-size: 30rpx;
  border: none;
  margin-top: 20rpx;
}

.copy-btn {
  background: #667eea;
  color: white;
}

.retry-btn {
  background: #f2f4ff;
  color: #667eea;
}

.copy-btn::after,
.retry-btn::after {
  border: none;
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.btn-text {
  font-size: 32rpx;
}

/* 用户信息输入表单 */
.user-input {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.input-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar-btn-wrapper {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn-wrapper::after {
  border: none;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f5f5f5;
  border: 2rpx dashed #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.avatar-btn.has-avatar {
  border: none;
  background: transparent;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.avatar-placeholder {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  line-height: 1.2;
  display: block;
  padding: 20rpx;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

.nickname-input:focus {
  border-color: #667eea;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 44rpx;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.submit-btn::after {
  border: none;
}

.footer {
  margin-top: auto;
  padding-top: 60rpx;
}

.footer-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
}
