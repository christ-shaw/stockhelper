.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 筛选区域 */
.filter-section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.filter-item {
  margin-bottom: 24rpx;
}

.filter-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.filter-input {
  width: 100%;
  height: 70rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.filter-picker {
  height: 70rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  background-color: #fff;
}

.date-range-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.date-range-picker .filter-picker {
  flex: 1;
}

.filter-separator {
  font-size: 28rpx;
  color: #999;
}

.filter-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.btn {
  flex: 1;
  height: 80rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background-color: #1890ff;
  color: #fff;
}

.btn-secondary {
  background-color: #fff;
  color: #666;
  border: 1rpx solid #d9d9d9;
}

/* 操作记录列表 */
.logs-list {
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.log-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.log-item:last-child {
  border-bottom: none;
}

.log-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.log-type-badge {
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
  color: #fff;
  margin-right: 16rpx;
}

.log-type {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 500;
  margin-right: 16rpx;
}

.log-time {
  margin-left: auto;
  font-size: 24rpx;
  color: #999;
}

.log-content {
  background-color: #fafafa;
  padding: 16rpx;
  border-radius: 8rpx;
}

.log-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.log-row:last-child {
  margin-bottom: 0;
}

.log-label {
  font-size: 26rpx;
  color: #666;
  min-width: 140rpx;
}

.log-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  word-break: break-all;
}

.log-id {
  font-size: 22rpx;
  color: #999;
  font-family: monospace;
}

/* 加载状态 */
.loading-status {
  text-align: center;
  padding: 40rpx;
  font-size: 28rpx;
  color: #999;
}

/* 无更多数据 */
.no-more {
  text-align: center;
  padding: 40rpx;
  font-size: 28rpx;
  color: #999;
}

/* 无数据 */
.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: #999;
}
