.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  margin-bottom: 30rpx;
  text-align: center;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.test-section {
  background: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.clear-btn {
  font-size: 24rpx;
  color: #1890ff;
  padding: 8rpx 16rpx;
}

.filter-group {
  margin-bottom: 20rpx;
}

.filter-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.radio-group {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.radio-item {
  flex: 1;
  min-width: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.radio-item.active {
  border-color: #1890ff;
  background-color: #e6f7ff;
  color: #1890ff;
  font-weight: bold;
}

.input {
  width: 100%;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  background-color: #f9f9f9;
  box-sizing: border-box;
}

.date-inputs {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-inputs .input {
  flex: 1;
}

.date-separator {
  font-size: 26rpx;
  color: #999;
}

.btn-group {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn {
  flex: 1;
  border-radius: 8rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.btn-primary {
  background-color: #1890ff;
  color: white;
}

.btn-secondary {
  background-color: #52c41a;
  color: white;
}

.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  background: white;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.btn-page {
  padding: 0 40rpx;
  background-color: #1890ff;
  color: white;
  font-size: 26rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 8rpx;
}

.btn-page.disabled {
  background-color: #d9d9d9;
  color: #999;
}

.page-info {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.result-list {
  max-height: 1200rpx;
  overflow-y: auto;
}

.result-item {
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background-color: #fafafa;
}

.result-item:last-child {
  margin-bottom: 0;
}

.result-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.result-row:last-child {
  margin-bottom: 0;
}

.result-label {
  width: 160rpx;
  color: #666;
  flex-shrink: 0;
}

.result-value {
  flex: 1;
  color: #333;
  word-break: break-all;
}

.status-issue {
  color: #ff4d4f;
  font-weight: bold;
}

.status-normal {
  color: #52c41a;
  font-weight: bold;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 26rpx;
}

.loading-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #1890ff;
  font-size: 26rpx;
}

.tips {
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.tips-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #fa8c16;
  margin-bottom: 16rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 8rpx;
  padding-left: 20rpx;
  position: relative;
}

.tips-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  background-color: #fa8c16;
  border-radius: 50%;
}
