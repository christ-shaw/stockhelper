/* 页面 */
page {
  width: 100%;
  height: 100%;
  background: #f0f2f5;
}

.container {
  height: 100vh;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

/* 日期范围 */
.date-range {
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 18rpx 24rpx;
  text-align: center;
  flex-shrink: 0;
}

.date-range-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* 图表卡片 - 两个图表各占一半 */
.chart-card {
  background: #fff;
  flex: 1;
  min-height: 0;
  margin-bottom: 4rpx;
}

.chart-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* 翻页按钮 */
.pagination {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 24rpx;
  flex-shrink: 0;
  background: #f0f2f5;
}

.btn-prev,
.btn-next {
  flex: 1;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 14rpx;
  padding: 20rpx 0;
  border: none;
  line-height: 1;
  box-shadow: 0 4rpx 10rpx rgba(102,126,234,0.3);
}

.btn-prev::after,
.btn-next::after { border: none; }
.btn-hover { opacity: 0.85; }
