.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  margin-bottom: 30rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.test-section {
  background: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.clear-btn {
  font-size: 24rpx;
  color: #1890ff;
  padding: 8rpx 16rpx;
}

.input-group {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.input {
  flex: 1;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background-color: #f9f9f9;
}

.btn {
  border-radius: 8rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
}

.btn-primary {
  background-color: #1890ff;
  color: white;
}

.btn-secondary {
  background-color: #52c41a;
  color: white;
}

.btn-info {
  background-color: #722ed1;
  color: white;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.btn-group {
  display: flex;
  flex-wrap: wrap;
}

.model-list {
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.model-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx;
  background: white;
  border-radius: 6rpx;
  margin-bottom: 8rpx;
  font-size: 26rpx;
}

.model-item:last-child {
  margin-bottom: 0;
}

.remove {
  color: #ff4d4f;
  font-size: 32rpx;
  padding: 0 10rpx;
}

.result-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.result-item {
  border-bottom: 1rpx solid #f0f0f0;
  padding: 20rpx 0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.result-action {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.result-time {
  font-size: 22rpx;
  color: #999;
}

.result-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
}

.result-status.success {
  color: #52c41a;
}

.result-status.failed {
  color: #ff4d4f;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}

.tips {
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.tips-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #fa8c16;
  margin-bottom: 16rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 8rpx;
  padding-left: 20rpx;
  position: relative;
}

.tips-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  background-color: #fa8c16;
  border-radius: 50%;
}
