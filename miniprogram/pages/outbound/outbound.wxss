/* pages/outbound/outbound.wxss */
.container {
  padding: 16rpx 24rpx;
  padding-bottom: 40rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.outbound-card {
  width: 90%;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 30rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.form-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 30rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.card-section {
  margin-bottom: 24rpx;
}

.card-section:last-child {
  margin-bottom: 0;
}

.phone-models-section {
  padding: 20rpx 0;
}

.phone-model-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.model-inputs {
  flex: 1;
  display: flex;
  gap: 12rpx;
  align-items: center;
  position: relative;
}

.model-input {
  flex: 3;
  height: 70rpx;
  padding: 0 20rpx;
  background: #fff;
  border: 2rpx solid #e9ecef;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.model-input:focus {
  border-color: #667eea;
  background: #fff;
}

.model-input::placeholder {
  color: #999;
}

.model-picker-wrapper {
  flex: 2;
  position: relative;
  height: 70rpx;
  z-index: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 8rpx;
  border: 2rpx solid #e9ecef;
}

.model-picker-popup {
  position: absolute;
  top: 80rpx;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 1000;
  max-height: 600rpx;
  border: 1rpx solid #e9ecef;
  overflow: hidden;
}

.cascade-picker {
  display: grid;
  grid-template-columns: 1fr 1.25fr 1fr;
  height: 520rpx;
}

.cascade-column {
  height: 520rpx;
  border-right: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.cascade-column:last-child {
  border-right: none;
}

.cascade-title {
  position: sticky;
  top: 0;
  z-index: 2;
  padding: 14rpx 16rpx;
  background: #f8f9fa;
  color: #666;
  font-size: 24rpx;
  font-weight: 600;
  border-bottom: 1rpx solid #e9ecef;
}

.cascade-item {
  min-height: 72rpx;
  padding: 16rpx;
  display: flex;
  align-items: center;
  color: #333;
  font-size: 24rpx;
  line-height: 1.25;
  border-bottom: 1rpx solid #f5f5f5;
  word-break: break-all;
}

.cascade-item.active {
  color: #1677ff;
  background: #f0f7ff;
  font-weight: 600;
}

.cascade-item:active {
  background: #f8f9fa;
}

.model-search-wrapper {
  padding: 12rpx;
  border-bottom: 1rpx solid #e9ecef;
}

.model-search-input {
  width: 100%;
  height: 60rpx;
  padding: 0 16rpx;
  background: #f8f9fa;
  border: 1rpx solid #e9ecef;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
  box-sizing: border-box;
}

.model-search-input:focus {
  border-color: #667eea;
  background: #fff;
}

.model-search-input::placeholder {
  color: #999;
}

.search-result-list {
  height: 460rpx;
}

.search-result-item {
  min-height: 72rpx;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  color: #333;
  font-size: 26rpx;
  line-height: 1.3;
  border-bottom: 1rpx solid #f0f0f0;
  word-break: break-all;
}

.search-result-item:active {
  background: #f0f7ff;
  color: #1677ff;
}

.picker-list {
  height: 600rpx;
  width: calc(100% - 50rpx);
  box-sizing: border-box;
}

.picker-letter {
  padding: 12rpx 24rpx;
  padding-right: 60rpx;
  background: #f0f0f0;
  font-size: 24rpx;
  font-weight: bold;
  color: #666;
  border-bottom: 1rpx solid #e9ecef;
  position: relative;
  z-index: 1;
}

.picker-model-item {
  padding: 20rpx 24rpx;
  padding-right: 60rpx;
  border-bottom: 1rpx solid #f0f0f0;
  cursor: pointer;
  position: relative;
  z-index: 1;
}

.picker-model-item:last-child {
  border-bottom: none;
}

.picker-model-item:active {
  background: #f8f9fa;
}

.picker-item-text {
  font-size: 26rpx;
  color: #333;
}

.picker-empty {
  padding: 40rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.letter-index {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8f9fa;
  border-left: 1rpx solid #e9ecef;
  z-index: 10;
}

.letter-item {
  padding: 6rpx 0;
  font-size: 22rpx;
  color: #666;
  text-align: center;
  width: 100%;
  cursor: pointer;
}

.letter-item:active {
  color: #667eea;
  font-weight: bold;
}

.picker-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 20rpx;
  color: #999;
}

.quantity-input {
  flex: 1;
  height: 70rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
  text-align: center;
  border: 2rpx solid #e9ecef;
  position: relative;
}

.quantity-wrapper {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.quantity-btn {
  width: 60rpx;
  height: 70rpx;
  background: #fff;
  border: 2rpx solid #e9ecef;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #1890ff;
  transition: all 0.2s;
}

.quantity-btn:active {
  background: #e6f7ff;
  border-color: #1890ff;
}

.quantity-wrapper .quantity-input {
  flex: 1;
  height: 70rpx;
  padding: 0 10rpx;
  background: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
  text-align: center;
  border: 2rpx solid #e9ecef;
  min-width: 80rpx;
}

.delete-model-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 30rpx 0;
}

.quantity-summary {
  margin-top: 24rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
  border-radius: 12rpx;
  border: 2rpx solid rgba(102, 126, 234, 0.2);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #667eea;
}

.summary-total {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.total-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #667eea;
}

.total-label {
  font-size: 28rpx;
  color: #667eea;
}

.add-btn {
  color: #667eea;
  font-size: 26rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.card-icon {
  font-size: 32rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.date-picker-large {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  padding: 0 20rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
}

.date-value-large {
  flex: 1;
  margin-left: 10rpx;
  color: #fff;
}

.date-value-large.placeholder {
  color: rgba(255, 255, 255, 0.8);
}

.date-arrow-large {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.customer-input-wrapper {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 4rpx;
}

.customer-input {

  height: 72rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid transparent;
}

.customer-input:focus {
  border-color: #667eea;
}

.photo-count-badge {
  margin-left: auto;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.photo-section {
  margin-bottom: 0;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.photo-item {
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  background: #fafafa;
}

.photo-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.upload-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #d9d9d9;
  background: #fafafa;
}

.upload-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.upload-icon {
  font-size: 60rpx;
  color: #999;
  line-height: 1;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

.delete-photo-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-photo-btn .delete-icon {
  color: #fff;
  font-size: 40rpx;
  line-height: 1;
  font-weight: 300;
}

.photo-empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.tip-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.tip-text {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.tip-desc {
  font-size: 24rpx;
  color: #999;
}

.submit-wrapper {
  margin-bottom: 16rpx;
}

.submit-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
  padding: 0;
}

.submit-btn::after {
  border: none;
}

.records-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.records-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.records-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.clear-btn {
  font-size: 28rpx;
  color: #667eea;
}

.records-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  margin-bottom: 12rpx;
}

.record-card {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.record-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.customer-avatar {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.record-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.date-info {
  font-size: 24rpx;
  color: #666;
}

.photo-info {
  font-size: 24rpx;
  color: #666;
}

.record-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.record-models {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.models-label {
  color: #999;
}

.models-list {
  color: #333;
}

.view-btn {
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.delete-icon {
  font-size: 60rpx;
  color: #ff4d4f;
  line-height: 1;
  font-weight: 300;
}

.record-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;

  height: 60rpx;
  flex-shrink: 0;
}
/* 手机型号选择模态框 */

.model-selected-text {
  flex: 1;
  padding: 0 20rpx;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  pointer-events: none;
}

.upload-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.section-subtitle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.form-input-wrapper {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 100%;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  height: 80rpx;
}

.form-input {
  flex: 2;
  height: 64rpx;
  padding: 0 24rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid #e9ecef;
}

.form-input:focus {
  border-color: #667eea;
  background: #fff;
}

.form-input::placeholder {
  color: #999;
}

.scan-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  font-size: 28rpx;
  background: #f8f9fa;
  color: #333;
  border-radius: 8rpx;
  border: 2rpx solid #e9ecef;
}

.scan-btn::after {
  border: none;
}

.scan-btn[disabled] {
  opacity: 0.6;
}
