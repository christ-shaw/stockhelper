<!--pages/outbound/outbound.wxml-->
<view class="container">
  <!-- 出库信息卡片 -->
  <view class="outbound-card">
    <!-- 日期选择 -->
    <view class="card-section">
      <view class="card-header">
        <text class="card-icon">📅</text>
        <text class="card-title">出库日期</text>
      </view>
      <picker
        mode="date"
        value="{{outboundForm.outboundDate}}"
        bindchange="bindDateChange"
      >
        <view class="date-picker-large">
          <text class="date-value-large">{{outboundForm.outboundDate || '请选择日期'}}</text>
          <text class="date-arrow-large">›</text>
        </view>
      </picker>
    </view>
  

    <!-- 客户姓名 -->
    <view class="card-section">
      <view class="card-header">
        <text class="card-icon">👤</text>
        <text class="card-title">客户姓名</text>
      </view>
      <view class="customer-input-wrapper">
        <input
          class="customer-input"
          value="{{outboundForm.customerName}}"
          placeholder="请输入客户姓名"
          bindinput="onInput"
          data-field="customerName"
        />
      </view>
    </view>

    <!-- 快递单号 -->
    <view class="card-section">
      <view class="card-header">
        <text class="card-icon">📦</text>
        <text class="card-title">快递单号</text>
      </view>
      <view class="form-input-wrapper">
        <input
          class="form-input"
          value="{{outboundForm.trackingNumber}}"
          placeholder="扫描或输入快递单号"
          bindinput="onInput"
          data-field="trackingNumber"
        />
        <button
          class="scan-btn"
          bindtap="startScan"
          disabled="{{scanning}}"
        >
          {{scanning ? '扫描中...' : '📷'}}
        </button>
      </view>
    </view>

    <!-- 手机型号 -->
    <view class="card-section phone-models-section">
      <view class="card-header">
        <text class="card-icon">📱</text>
        <text class="card-title">手机型号</text>
        <text class="add-btn" bindtap="addPhoneModel">+ 添加</text>
      </view>

      <view
        class="phone-model-item"
        wx:for="{{outboundForm.phoneModels}}"
        wx:key="index"
      >
        <view class="model-inputs">
          <view class="model-picker-wrapper" bindtap="showModelPicker" data-index="{{index}}">
            <text class="picker-icon">▼</text>
            <view class="model-selected-text">{{item.model || '请选择型号'}}</view>
          </view>
          <!-- 型号选择弹窗 -->
          <view class="model-picker-popup" wx:if="{{showModelPickerFlag && pickerIndex === index}}">
            <view class="model-search-wrapper">
              <input
                class="model-search-input"
                type="text"
                value="{{modelSearchKeyword}}"
                placeholder="搜索品牌 / 货品 / 规格"
                bindinput="onModelSearch"
                data-index="{{index}}"
              />
            </view>
            <scroll-view scroll-y class="search-result-list" wx:if="{{modelSearchKeyword}}">
              <view
                class="search-result-item"
                wx:for="{{filteredProductOptions}}"
                wx:for-item="option"
                wx:for-index="optionIndex"
                wx:key="label"
                bindtap="selectFilteredProduct"
                data-option-index="{{optionIndex}}"
              >
                {{option.label}}
              </view>
              <view class="picker-empty" wx:if="{{filteredProductOptions.length === 0}}">
                未找到匹配型号
              </view>
            </scroll-view>
            <view class="cascade-picker" wx:elif="{{productBrands.length > 0}}">
              <scroll-view scroll-y class="cascade-column">
                <view class="cascade-title">品牌</view>
                <view
                  class="cascade-item {{currentBrandIndex === brandIndex ? 'active' : ''}}"
                  wx:for="{{productBrands}}"
                  wx:for-item="brand"
                  wx:for-index="brandIndex"
                  wx:key="brand"
                  bindtap="selectPickerBrand"
                  data-brand-index="{{brandIndex}}"
                >
                  {{brand.brand}}
                </view>
              </scroll-view>
              <scroll-view scroll-y class="cascade-column">
                <view class="cascade-title">货品</view>
                <view
                  class="cascade-item {{currentProductIndex === productIndex ? 'active' : ''}}"
                  wx:for="{{currentProducts}}"
                  wx:for-item="product"
                  wx:for-index="productIndex"
                  wx:key="name"
                  bindtap="selectPickerProduct"
                  data-product-index="{{productIndex}}"
                >
                  {{product.name}}
                </view>
              </scroll-view>
              <scroll-view scroll-y class="cascade-column">
                <view class="cascade-title">规格</view>
                <view
                  class="cascade-item"
                  wx:for="{{currentSpecs}}"
                  wx:for-item="spec"
                  wx:for-index="specIndex"
                  wx:key="name"
                  bindtap="selectPickerSpec"
                  data-spec-index="{{specIndex}}"
                >
                  {{spec.name}}
                </view>
              </scroll-view>
            </view>
            <view class="picker-empty" wx:else>
              暂无可选型号
            </view>
          </view>
          <view class="quantity-wrapper">
            <view
              class="quantity-btn decrease-btn"
              bindtap="changeQuantity"
              data-index="{{index}}"
              data-type="decrease"
            >
              -
            </view>
            <input
              class="quantity-input"
              type="number"
              value="{{item.quantity}}"
              placeholder="0"
              bindinput="onPhoneQuantityInput"
              bindblur="onPhoneQuantityBlur"
              data-index="{{index}}" />
            <view
              class="quantity-btn increase-btn"
              bindtap="changeQuantity"
              data-index="{{index}}"
              data-type="increase"
            >
              +
            </view>
          </view>
        </view>
        <view
          class="delete-model-btn"
          catchtap="deletePhoneModel"
          data-index="{{index}}"
        >
          <text class="delete-icon">×</text>
        </view>
      </view>
      <view class="empty-tip" wx:if="{{outboundForm.phoneModels.length === 0}}">请添加至少一个手机型号</view>
      <!-- 数量汇总 -->
      <view class="quantity-summary" wx:if="{{outboundForm.phoneModels.length > 0}}">
        <text class="summary-label">总计:</text>
        <view class="summary-total">
          <text class="total-number">{{totalQuantity}}</text>
          <text class="total-label">台</text>
        </view>
      </view>
    </view>

    <!-- 照片上传 -->
    <view class="card-section photo-section">
      <view class="card-header">
        <text class="card-icon">📸</text>
        <text class="card-title">出库手机照片</text>
        <text class="photo-count-badge">{{outboundForm.phonePhotos.length}}/9</text>
      </view>

      <view class="photo-grid">
        <view class="photo-item" wx:for="{{outboundForm.phonePhotos}}" wx:for-item="photo" wx:for-index="photoIndex" wx:key="photoIndex">
          <image class="photo-image" src="{{photo}}" mode="aspectFill" bindtap="previewPhonePhoto" data-index="{{photoIndex}}"></image>
          <view class="delete-photo-btn" catchtap="deletePhonePhoto" data-index="{{photoIndex}}">
            <text class="delete-icon">×</text>
          </view>
        </view>
        <view class="photo-item upload-item" wx:if="{{outboundForm.phonePhotos.length < 9}}" bindtap="choosePhonePhotos">
          <view class="upload-content">
            <text class="upload-icon">+</text>
            <text class="upload-text">添加照片</text>
          </view>
        </view>
      </view>

      <view class="photo-empty-tip" wx:if="{{outboundForm.phonePhotos.length === 0}}">
        <text class="tip-icon">📷</text>
        <text class="tip-text">请上传出库手机照片</text>
        <text class="tip-desc">支持最多9张照片</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-wrapper">
    <button class="submit-btn" bindtap="submitOutbound" disabled="{{submitting}}" loading="{{submitting}}">{{submitting ? '提交中...' : '确认出库'}}</button>
  </view>
</view>
