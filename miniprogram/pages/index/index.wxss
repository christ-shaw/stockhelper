.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 160rpx;
}

.nav-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32rpx;
  width: 100%;
  max-width: 600rpx;
}

.nav-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
}

.pending-order-card {
  position: relative;
}

.nav-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.inbound-icon {
  background: linear-gradient(135deg, #4facfe, #00f2fe);
}

.imei-icon {
  background: linear-gradient(135deg, #43cea2, #185a9d);
  color: #fff;
}

.outbound-icon {
  background: linear-gradient(135deg, #ff9a9e, #fecfef);
}

.pending-order-icon {
  position: relative;
  background: linear-gradient(135deg, #ffb347, #ff7a45);
}

.pending-count-dot {
  position: absolute;
  top: -10rpx;
  right: -12rpx;
  min-width: 42rpx;
  height: 42rpx;
  padding: 0 10rpx;
  border-radius: 21rpx;
  background: #f5222d;
  color: #fff;
  font-size: 22rpx;
  line-height: 42rpx;
  text-align: center;
  font-weight: bold;
  box-sizing: border-box;
}

.query-icon {
  background: linear-gradient(135deg, #667eea, #764ba2);
}

.dashboard-icon {
  background: linear-gradient(135deg, #fa709a, #fee140);
}

.operation-log-icon {
  background: linear-gradient(135deg, #f093fb, #f5576c);
}

.nav-icon {
  font-size: 60rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.nav-desc {
  font-size: 24rpx;
  color: #999;
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100vw;
  background: white;
  display: flex;
  padding: 20rpx 0;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.1);
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.nav-item.active .nav-text {
  color: #667eea;
  font-weight: bold;
}

.nav-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.nav-text {
  font-size: 28rpx;
  color: #999;
}
