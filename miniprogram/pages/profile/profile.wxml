<view class="container">
  <view class="header">
    <image class="avatar" src="{{userInfo ? userInfo.avatarUrl : ''}}" mode="aspectFill"></image>
    <text class="nickname">{{userInfo ? userInfo.nickname : '未登录'}}</text>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="showDebugInfo">
      <view class="menu-item-left">
        <text class="menu-icon">🔍</text>
        <text class="menu-text">查看用户信息</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="refreshUserInfo">
      <view class="menu-item-left">
        <text class="menu-icon">🔄</text>
        <text class="menu-text">刷新用户信息</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goToAbout">
      <view class="menu-item-left">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于我们</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="logout">
      <view class="menu-item-left">
        <text class="menu-icon">🚪</text>
        <text class="menu-text">退出登录</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item" bindtap="goToIndex">
      <text class="nav-icon">🏠</text>
      <text class="nav-text">首页</text>
    </view>
    <view class="nav-item active" bindtap="stayOnPage">
      <text class="nav-icon">👤</text>
      <text class="nav-text">我的</text>
    </view>
  </view>
</view>
